{
    "name": "(1)Balandro Multi-B\u00fasqueda",
    "plugin": "plugin.video.balandro.bridge.multi",
    "priority": 100,
    "is_resolvable": "true",
    "assert": {
        "play_movie": [
            "title"
        ],
        "play_episode": [
            "showname",
            "season",
            "episode"
        ]
    },
    "play_movie": [
        "plugin://plugin.video.balandro.bridge.multi/?url=plugin://plugin.video.balandro/?action=search&title={es-MX_title}&year={year}&title_es={es-ES_title}&title_lat={es-MX_title}&tmdb={tmdb}&imdb={imdb}&tvdb={tvdb}&trakt={trakt}&plot={plot}&tagline={tagline}&director={director}&plot_lat={es-MX_plot}&plot_es={es-ES_plot}&tagline_lat={es-MX_tagline}&tagline_es={es-ES_tagline}",
        {
            "title": "(?i)^({es-ES_title}|{es-MX_title}|{en_title}|{originaltitle}|.+)",
            "year": "{year}"
        }
    ],
    "play_episode": [
        "plugin://plugin.video.balandro.bridge.multi/?url=plugin://plugin.video.balandro/?action=search&title={es-MX_showname}&season={season}&episode={episode}&showname={showname}&showyear={showyear}&title_es={es-ES_showname}&title_lat={es-MX_showname}&tmdb={tmdb}&imdb={imdb}&tvdb={tvdb}&trakt={trakt}&plot={plot}&tagline={tagline}&director={director}&plot_lat={es-MX_plot}&plot_es={es-ES_plot}&tagline_lat={es-MX_tagline}&tagline_es={es-ES_tagline}",
        {
            "title": "(?i)^({es-ES_showname}|{es-MX_showname}|{en_showname}|{original_name}|.+)",
            "season": "{season}",
            "episode": "{episode}"
        }
    ],
    "is_folder": "false"
}