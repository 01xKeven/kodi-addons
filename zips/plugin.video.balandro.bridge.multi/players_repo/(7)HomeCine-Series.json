{
    "name": "(7)HomeCine-Series",
    "plugin": "plugin.video.balandro.bridge.multi",
    "priority": 200,
    "is_resolvable": "true",
    "assert": {
        "play_episode": [
            "showname",
            "season",
            "episode"
        ]
    },
    "play_episode": [
        "plugin://plugin.video.balandro.bridge.multi/?url=plugin://plugin.video.balandro/?%3D%3D&showname={showname}&showyear={showyear}&season={season}&episode={episode}&title_es={es-ES_showname}&title_lat={es-MX_showname}&tmdb={tmdb}&imdb={imdb}&tvdb={tvdb}&trakt={trakt}&plot={plot}&tagline={tagline}&director={director}&plot_lat={es-MX_plot}&plot_es={es-ES_plot}&tagline_lat={es-MX_tagline}&tagline_es={es-ES_tagline}",
        {
            "title": "(?i)^({es-ES_showname}|{es-MX_showname}|{en_showname}|{original_name}|.+)",
            "season": "{season}",
            "episode": "{episode}"
        }
    ],
    "fallback": {
        "play_episode": "(8)RePelisHd-Series.json play_episode"
    },
    "is_folder": "false"
}