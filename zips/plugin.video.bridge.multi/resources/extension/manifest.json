{
  "name": "WebStream Bridge",
  "version": "2.0",
  "manifest_version": 3,
  "description": "Intercepts media stream URLs for Kodi Web Stream Bridge and blocks popups",
  "permissions": [
    "webRequest",
    "webRequestExtraHeaders",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["port.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["port.js", "port.json", "page_hook.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
