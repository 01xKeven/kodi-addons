<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">300</defaultcontrol>
    <zorder>101</zorder>
    <coordinates>
        <system>1</system>
        <left>0</left>
        <top>0</top>
    </coordinates>
    <controls>
        <!-- Oscurecimiento de pantalla de fondo (igual que autoplay) -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>1080</height>
            <texture colordiffuse="88000000">white.png</texture>
            <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
        </control>

        <!-- TARJETA PRINCIPAL (misma geometría que autoplay.xml) -->
        <control type="group">
            <animation effect="zoom" start="90" end="100" center="960,535" time="250" tween="quadratic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>

            <!-- Fondo oscuro con esquinas redondeadas -->
            <control type="image">
                <left>420</left><top>315</top>
                <width>1080</width><height>440</height>
                <texture border="32">dialog_bg.png</texture>
                <colordiffuse>E60D1117</colordiffuse>
            </control>

            <!-- Capa de poster/fanart sutil (reutiliza la misma propiedad de autoplay) -->
            <control type="image">
                <left>420</left><top>315</top>
                <width>1080</width><height>440</height>
                <texture background="true" diffuse="dialog_mask.png">$INFO[Window(10000).Property(bridge.nolinks_fanart)]</texture>
                <colordiffuse>18FFFFFF</colordiffuse>
                <aspectratio aligny="center">scale</aspectratio>
            </control>

            <!-- Borde dorado tenue permanente -->
            <control type="image">
                <left>420</left><top>315</top>
                <width>1080</width><height>440</height>
                <texture border="32">dialog_border.png</texture>
                <colordiffuse>70FF4444</colordiffuse>
            </control>

            <!-- POSTER (misma posición y tamaño que autoplay) -->
            <control type="image">
                <left>445</left><top>348</top>
                <width>250</width><height>375</height>
                <texture background="true" diffuse="thumbs/movieposter_mask.png">$INFO[Window(10000).Property(bridge.nolinks_poster)]</texture>
                <fallback>DefaultVideo.png</fallback>
                <aspectratio aligny="top">scale</aspectratio>
            </control>

            <!-- CABECERA: MULTI BRIDGE • SIN RESULTADOS -->
            <control type="label">
                <left>725</left><top>355</top>
                <width>750</width><height>20</height>
                <font>font11</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>[B][COLOR FFD4AF37]MULTI BRIDGE[/COLOR][/B]  •  [B]SIN RESULTADOS[/B]</label>
            </control>

            <!-- TITULO PRINCIPAL -->
            <control type="label" id="3001">
                <left>725</left><top>410</top>
                <width>750</width><height>56</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <wrapmultiline>true</wrapmultiline>
                <label>[B]$INFO[Window(10000).Property(bridge.nolinks_title)][/B]$INFO[Window(10000).Property(bridge.nolinks_episode_display)]</label>
            </control>

            <!-- ICONO DE ADVERTENCIA (en lugar del spinner de autoplay) -->
            <control type="image">
                <left>725</left><top>474</top>
                <width>72</width><height>72</height>
                <aspectratio align="center" aligny="center">keep</aspectratio>
                <texture colordiffuse="FFFF4444">DefaultIconWarning.png</texture>
            </control>

            <!-- TEXTO DE ESTADO: mensaje principal — ancho máximo, nunca se corta -->
            <control type="label" id="3002">
                <left>810</left><top>474</top>
                <width>650</width><height>24</height>
                <font>font12</font>
                <textcolor>FFFFFFFF</textcolor>
                <wrapmultiline>true</wrapmultiline>
                <label>[B]$INFO[Window(10000).Property(bridge.nolinks_message)][/B]</label>
            </control>

            <!-- SUBTEXTO: descripción adicional — siempre completo, 2 líneas, separado 8px -->
            <control type="label" id="3003">
                <left>810</left><top>506</top>
                <width>650</width><height>44</height>
                <font>font11</font>
                <textcolor>FFA0AEC0</textcolor>
                <wrapmultiline>true</wrapmultiline>
                <label>$INFO[Window(10000).Property(bridge.nolinks_submessage)]</label>
            </control>

            <!-- BOTON ACEPTAR (ID 300) - único botón, centrado -->
            <control type="button" id="300">
                <left>835</left><top>626</top>
                <width>270</width><height>60</height>
                <label>[B]Aceptar[/B]</label>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <focusedcolor>FFFFB000</focusedcolor>
                <texturefocus colordiffuse="70FF4444">white.png</texturefocus>
                <texturenofocus colordiffuse="30FFFFFF">white.png</texturenofocus>
                <align>center</align>
                <aligny>center</aligny>
                <pulseonselect>true</pulseonselect>
                <onleft>300</onleft>
                <onright>300</onright>
                <onup>300</onup>
                <ondown>300</ondown>
                <!-- onclick manejado por Python onClick(300) → self.close() — NO poner Action(Close) aquí para evitar double-close crash -->
                <onback>Action(Back)</onback>
            </control>
        </control>
    </controls>
</window>
