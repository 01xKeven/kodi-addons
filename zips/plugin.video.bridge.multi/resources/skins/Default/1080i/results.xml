<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <controls>
        <!-- FONDO OSCURO CON TEXTURA Y FANART SUTIL -->
        <control type="group">
            <animation effect="zoom" start="0" end="100" time="200" center="auto" tween="quadratic" easing="out">WindowOpen</animation>
            <control type="image">
                <left>0</left><top>0</top>
                <width>1920</width><height>1080</height>
                <texture>texture.png</texture>
            </control>
            <control type="image">
                <left>0</left><top>0</top>
                <width>1920</width><height>1080</height>
                <texture>$INFO[Window.Property(bridge.fanart)]</texture>
                <colordiffuse>10FFFFFF</colordiffuse>
                <animation effect="fade" start="0" end="100" time="500" tween="sine">WindowOpen</animation>
            </control>
        </control>

        <!-- CABECERA: CLEARLOGO / TITULO + EPISODIO + CONTADORES DE CALIDAD -->
        <control type="group">
            <animation effect="fade" start="0" end="100" delay="400" time="500">WindowOpen</animation>

            <!-- CLEARLOGO -->
            <control type="image">
                <left>35</left><top>15</top>
                <width>300</width><height>80</height>
                <aspectratio aligny="center" align="left">keep</aspectratio>
                <texture>$INFO[Window.Property(bridge.clearlogo)]</texture>
                <visible>!String.IsEmpty(Window.Property(bridge.clearlogo))</visible>
            </control>

            <!-- ETIQUETA DE EPISODIO (Junto a Clearlogo si es serie) -->
            <control type="label">
                <left>350</left><top>40</top>
                <width max="400">auto</width><height>30</height>
                <font>font14</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>left</align><aligny>center</aligny>
                <label>[B][COLOR yellow]$INFO[Window.Property(bridge.episode_label)][/COLOR][/B]</label>
                <visible>!String.IsEmpty(Window.Property(bridge.clearlogo)) + !String.IsEmpty(Window.Property(bridge.episode_label))</visible>
            </control>

            <!-- TITULO DE TEXTO SI NO HAY CLEARLOGO -->
            <control type="label">
                <left>35</left><top>35</top>
                <width max="700">auto</width><height>30</height>
                <font>font14</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>left</align><aligny>center</aligny>
                <label>[UPPERCASE][B]$INFO[Window.Property(bridge.title)][/B][/UPPERCASE]</label>
                <visible>String.IsEmpty(Window.Property(bridge.clearlogo))</visible>
            </control>

            <!-- ESTADISTICAS DE RESOLUCION (4K, 1080p, 720p, SD | Total Results) -->
            <control type="label">
                <left>500</left><top>40</top>
                <width max="1200">auto</width><height>28</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>left</align><aligny>center</aligny>
                <label>[COLOR $INFO[Window.Property(bridge.color_4k)]][B]4K: $INFO[Window.Property(bridge.count_4k)][/B][/COLOR]  [COLOR $INFO[Window.Property(bridge.color_1080p)]][B]1080p: $INFO[Window.Property(bridge.count_1080p)][/B][/COLOR]  [COLOR $INFO[Window.Property(bridge.color_720p)]][B]720p: $INFO[Window.Property(bridge.count_720p)][/B][/COLOR]  [COLOR $INFO[Window.Property(bridge.color_sd)]][B]SD: $INFO[Window.Property(bridge.count_sd)][/B][/COLOR]  |  [B]$INFO[Window.Property(bridge.total_results)] Resultados[/B]</label>
            </control>
        </control>

                <!-- INDICADOR SUPERIOR DERECHO (AUDIO / IDIOMAS DISPONIBLES) -->
        <control type="group">
            <visible>!String.IsEmpty(Window.Property(bridge.lang_text))</visible>
            <animation effect="fade" start="0" end="100" time="500">Visible</animation>
            <left>1395</left><top>30</top>
            <!-- Línea de acento naranja -->
            <control type="image">
                <left>0</left><top>0</top>
                <width>486</width><height>2</height>
                <texture colordiffuse="FFffa500">white.png</texture>
            </control>
            <control type="label">
                <left>20</left><top>0</top>
                <width>460</width><height>70</height>
                <font>font13</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>left</align><aligny>center</aligny>
                <label>[B][COLOR orange]$INFO[Window.Property(bridge.lang_text)][/COLOR][/B]</label>
            </control>
        </control>

        <!-- COLUMNA DERECHA: POSTER + SINOPSIS (PLOT) -->
        <control type="group">
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="250" tween="sine" delay="350" easing="in" />
                <effect type="slide" start="500" end="0" time="250" center="auto" delay="350" tween="quadratic" easing="out" />
            </animation>
            <control type="image">
                <left>1395</left><top>100</top>
                <width>486</width><height>729</height>
                <aspectratio aligny="top">keep</aspectratio>
                <texture background="true" diffuse="thumbs/movieposter_mask.png">$INFO[Container(2000).ListItem.Property(bridge.poster)]</texture>
                <enable>false</enable>
            </control>
            <control type="textbox">
                <left>1395</left><top>845</top>
                <width>486</width><height>195</height>
                <font>font12</font>
                <align>justify</align><aligny>top</aligny>
                <label>$INFO[Container(2000).ListItem.Property(bridge.plot)]</label>
                <textcolor>FFFFFFFF</textcolor>
                <autoscroll time="2000" delay="5500" repeat="5000"></autoscroll>
                <enable>false</enable>
            </control>
            <control type="button" id="3000">
                <left>1395</left><top>100</top>
                <width>486</width><height>924</height>
                <texturefocus colordiffuse="00FFFFFF">white.png</texturefocus>
                <texturenofocus colordiffuse="00FFFFFF">white.png</texturenofocus>
                <label>-</label>
                <font>font12</font>
                <textcolor>00FFFFFF</textcolor>
                <focusedcolor>00FFFFFF</focusedcolor>
                <onleft>2000</onleft>
                <onright>2060</onright>
                <onup>2000</onup>
                <ondown>2000</ondown>
            </control>
        </control>

        <!-- LISTA PRINCIPAL (FIXEDLIST) + SCROLLBAR -->
        <control type="group">
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="400" tween="sine" delay="200" easing="in" />
                <effect type="slide" start="-1300" end="0" time="400" center="auto" tween="quadratic" delay="200" easing="out" />
            </animation>

            <control type="fixedlist" id="2000">
                <pagecontrol>2060</pagecontrol>
                <left>35</left><top>85</top>
                <width>1300</width><height>960</height>
                <onup>2000</onup>
                <ondown>2000</ondown>
                <onright>2060</onright>
                <scrolltime tween="sine">350</scrolltime>
                <orientation>Vertical</orientation>
                <focusposition>3</focusposition>
                <movement>4</movement>

                <!-- ITEM NORMAL (NO SELECCIONADO) -->
                <itemlayout height="120" width="1300">
                    <control type="image">
                        <left>0</left><top>15</top>
                        <width>1300</width><height>110</height>
                        <texture colordiffuse="$INFO[ListItem.Property(bridge.highlight_dim)]">white.png</texture>
                    </control>

                    <!-- BORDE DESTACADO PARA ENLACE EN REPRODUCCION -->
                    <control type="group">
                        <visible>String.IsEqual(ListItem.Property(bridge.is_playing),true)</visible>
                        <!-- Borde Superior -->
                        <control type="image">
                            <left>0</left><top>15</top>
                            <width>1300</width><height>2</height>
                            <texture colordiffuse="FF00FF7F">white.png</texture>
                        </control>
                        <!-- Borde Inferior -->
                        <control type="image">
                            <left>0</left><top>123</top>
                            <width>1300</width><height>2</height>
                            <texture colordiffuse="FF00FF7F">white.png</texture>
                        </control>
                        <!-- Borde Izquierdo (barra de acento destacada) -->
                        <control type="image">
                            <left>0</left><top>15</top>
                            <width>5</width><height>110</height>
                            <texture colordiffuse="FF00FF7F">white.png</texture>
                        </control>
                        <!-- Borde Derecho -->
                        <control type="image">
                            <left>1298</left><top>15</top>
                            <width>2</width><height>110</height>
                            <texture colordiffuse="FF00FF7F">white.png</texture>
                        </control>
                    </control>
                    
                    <!-- COLUMNA IZQUIERDA: CALIDAD Y TIPO -->
                    <control type="group">
                        <left>0</left><top>15</top>
                        <width>200</width><height>110</height>
                        <control type="label">
                            <left>0</left><top>15</top>
                            <width>200</width><height>40</height>
                            <font>font30</font>
                            <align>center</align><aligny>center</aligny>
                            <label>[COLOR $INFO[ListItem.Property(bridge.highlight)]][B]$INFO[ListItem.Property(bridge.quality)][/B][/COLOR]</label>
                        </control>
                        <control type="label">
                            <left>0</left><top>55</top>
                            <width>200</width><height>40</height>
                            <font>font30</font>
                            <align>center</align><aligny>center</aligny>
                            <label>[COLOR $INFO[ListItem.Property(bridge.highlight)]][B]$INFO[ListItem.Property(bridge.type)][/B][/COLOR]</label>
                        </control>
                    </control>
                    
                    <!-- LINEA 1: NOMBRE / TITULO -->
                    <control type="label">
                        <top>22</top><left>210</left>
                        <width max="1070">auto</width><height>30</height>
                        <font>font14</font>
                        <textcolor>FF9c9a9b</textcolor>
                        <align>left</align><aligny>center</aligny>
                        <label>[UPPERCASE]$INFO[ListItem.Property(bridge.count)]  $INFO[ListItem.Property(bridge.name)][/UPPERCASE]</label>
                    </control>
                    
                    <!-- LINEA 2: METADATOS Y SERVIDORES (TAMANO | SERVIDOR | CANAL | IDIOMA) -->
                    <control type="label">
                        <top>62</top><left>210</left>
                        <width max="1070">auto</width><height>40</height>
                        <font>font13</font>
                        <textcolor>FF808080</textcolor>
                        <align>left</align><aligny>center</aligny>
                        <label>[UPPERCASE]$INFO[ListItem.Property(bridge.info_line_unfocus)][/UPPERCASE]</label>
                    </control>
                </itemlayout>

                <!-- ITEM FOCALIZADO (ACTIVO / SELECCIONADO) -->
                <focusedlayout height="120" width="1300">
                    <control type="group">
                        <animation type="Focus">
                            <effect type="zoom" start="100" end="102" time="100" tween="sine" easing="inout" center="650,60" />
                        </animation>
                        
                        <control type="image">
                            <left>0</left><top>15</top>
                            <width>1300</width><height>110</height>
                            <texture colordiffuse="$INFO[ListItem.Property(bridge.highlight_focus)]">white.png</texture>
                        </control>
                        
                        <!-- GRADIENTE HORIZONTAL -->
                        <control type="image">
                            <left>0</left><top>15</top>
                            <width>1300</width><height>110</height>
                            <texture flipx="true" colordiffuse="$INFO[ListItem.Property(bridge.highlight)]">gradient-diffuse-horizontal.png</texture>
                        </control>

                        <!-- BORDE DESTACADO PARA ENLACE EN REPRODUCCION -->
                        <control type="group">
                            <visible>String.IsEqual(ListItem.Property(bridge.is_playing),true)</visible>
                            <!-- Borde Superior -->
                            <control type="image">
                                <left>0</left><top>15</top>
                                <width>1300</width><height>2</height>
                                <texture colordiffuse="FF00FF7F">white.png</texture>
                            </control>
                            <!-- Borde Inferior -->
                            <control type="image">
                                <left>0</left><top>123</top>
                                <width>1300</width><height>2</height>
                                <texture colordiffuse="FF00FF7F">white.png</texture>
                            </control>
                            <!-- Borde Izquierdo (barra de acento destacada) -->
                            <control type="image">
                                <left>0</left><top>15</top>
                                <width>5</width><height>110</height>
                                <texture colordiffuse="FF00FF7F">white.png</texture>
                            </control>
                            <!-- Borde Derecho -->
                            <control type="image">
                                <left>1298</left><top>15</top>
                                <width>2</width><height>110</height>
                                <texture colordiffuse="FF00FF7F">white.png</texture>
                            </control>
                        </control>

                        <!-- COLUMNA IZQUIERDA -->
                        <control type="group">
                            <left>0</left><top>15</top>
                            <width>200</width><height>110</height>
                            <control type="label">
                                <left>0</left><top>15</top>
                                <width>200</width><height>40</height>
                                <font>font30</font>
                                <align>center</align><aligny>center</aligny>
                                <label>[B]$INFO[ListItem.Property(bridge.quality)][/B]</label>
                            </control>
                            <control type="label">
                                <left>0</left><top>55</top>
                                <width>200</width><height>40</height>
                                <font>font30</font>
                                <align>center</align><aligny>center</aligny>
                                <label>[B]$INFO[ListItem.Property(bridge.type)][/B]</label>
                            </control>
                        </control>

                        <!-- LINEA 1 CON AUTO-SCROLL AL ENFOCAR -->
                        <control type="label">
                            <top>22</top><left>210</left>
                            <width>1050</width><height>30</height>
                            <font>font14</font>
                            <textcolor>$INFO[ListItem.Property(bridge.title_color_focus)]</textcolor> 
                            <align>left</align><aligny>center</aligny>
                            <label>[B][COLOR $INFO[ListItem.Property(bridge.title_color_focus)]][UPPERCASE]$INFO[ListItem.Property(bridge.count)]  $INFO[ListItem.Property(bridge.name)][/UPPERCASE][/COLOR][/B]</label>
                            <scroll>true</scroll>
                            <scrolloutdelay>3000</scrolloutdelay>
                            <scrollspeed>60</scrollspeed>
                        </control>

                        <!-- LINEA 2 CON AUTO-SCROLL Y COLORES VIBRANTES -->
                        <control type="label">
                            <top>62</top><left>210</left>
                            <width>1050</width><height>40</height>
                            <font>font13</font>
                            <textcolor>FFCCCCCC</textcolor>
                            <align>left</align><aligny>center</aligny>
                            <label>[UPPERCASE]$INFO[ListItem.Property(bridge.info_line_focus)][/UPPERCASE]</label>
                            <scroll>true</scroll>
                            <scrolloutdelay>3000</scrolloutdelay>
                        </control>
                    </control>
                </focusedlayout>
            </control>

            <!-- SCROLLBAR VERTICAL NATIVO -->
            <control type="scrollbar" id="2060">
                <top>100</top><left>1360</left>
                <width>15</width><height>945</height>
                <onleft>2000</onleft>
                <onright>2000</onright>
                <texturesliderbackground colordiffuse="FF302F2F">white.png</texturesliderbackground>
                <texturesliderbar colordiffuse="FF555556">white.png</texturesliderbar>
                <texturesliderbarfocus colordiffuse="$INFO[Container(2000).ListItem.Property(bridge.highlight)]">white.png</texturesliderbarfocus>
                <showonepage>false</showonepage>
                <orientation>vertical</orientation>
                <visible>Control.IsVisible(2000)</visible>
            </control>
        </control>
    </controls>
</window>
