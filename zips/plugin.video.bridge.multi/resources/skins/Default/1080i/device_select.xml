<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog">
    <defaultcontrol always="true">100</defaultcontrol>
    <zorder>150</zorder>
    <coordinates>
        <system>1</system>
        <left>0</left>
        <top>0</top>
    </coordinates>
    <controls>
        <!-- Oscurecimiento de pantalla de fondo -->
        <control type="image">
            <left>0</left><top>0</top>
            <width>1920</width><height>1080</height>
            <texture colordiffuse="CC000000">white.png</texture>
            <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>
        </control>

        <!-- TARJETA PRINCIPAL DEL DIÁLOGO (980 x 480) -->
        <control type="group">
            <animation effect="zoom" start="90" end="100" center="960,540" time="250" tween="quadratic" easing="out">WindowOpen</animation>
            <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
            <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>

            <!-- Fondo oscuro con esquinas redondeadas -->
            <control type="image">
                <left>470</left><top>270</top>
                <width>980</width><height>480</height>
                <texture border="32">dialog_bg.png</texture>
                <colordiffuse>F20E131A</colordiffuse>
            </control>

            <!-- Borde redondeado dorado tenue -->
            <control type="image">
                <left>470</left><top>270</top>
                <width>980</width><height>480</height>
                <texture border="32">dialog_border.png</texture>
                <colordiffuse>80D4AF37</colordiffuse>
            </control>

            <!-- CABECERA: MULTI BRIDGE • CONFIGURACIÓN -->
            <control type="label">
                <left>470</left><top>305</top>
                <width>980</width><height>25</height>
                <font>font12</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>center</align>
                <scroll>false</scroll>
                <label>[B][COLOR FFD4AF37]MULTI BRIDGE[/COLOR][/B]   •   [COLOR FFFFFFFF]CONFIGURACIÓN[/COLOR]</label>
            </control>

            <!-- PREGUNTA PRINCIPAL -->
            <control type="label">
                <left>470</left><top>342</top>
                <width>980</width><height>40</height>
                <font>font14</font>
                <textcolor>FFFFFFFF</textcolor>
                <align>center</align>
                <scroll>false</scroll>
                <label>[B]¿En qué dispositivo estás usando Kodi?[/B]</label>
            </control>

            <!-- ======================================================== -->
            <!-- TARJETA 1: PC (ID 100)                                   -->
            <!-- ======================================================== -->
            <control type="group">
                <control type="button" id="100">
                    <left>510</left><top>410</top>
                    <width>430</width><height>280</height>
                    <label></label>
                    <texturefocus border="16" colordiffuse="3500FF7F">white.png</texturefocus>
                    <texturenofocus border="16" colordiffuse="15FFFFFF">white.png</texturenofocus>
                    <pulseonselect>true</pulseonselect>
                    <onleft>200</onleft>
                    <onright>200</onright>
                    <onup>100</onup>
                    <ondown>100</ondown>
                </control>
                <!-- Borde al enfocar PC -->
                <control type="image">
                    <left>510</left><top>410</top>
                    <width>430</width><height>280</height>
                    <texture border="16">dialog_border.png</texture>
                    <colordiffuse>9000FF7F</colordiffuse>
                    <visible>Control.HasFocus(100)</visible>
                </control>
                <!-- Título PC -->
                <control type="label">
                    <left>510</left><top>495</top>
                    <width>430</width><height>45</height>
                    <font>font16</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <scroll>false</scroll>
                    <label>[B]PC[/B]</label>
                </control>
                <!-- Estado PC -->
                <control type="label">
                    <left>510</left><top>560</top>
                    <width>430</width><height>30</height>
                    <font>font13</font>
                    <textcolor>FF00FF7F</textcolor>
                    <align>center</align>
                    <scroll>false</scroll>
                    <label>[B]● Captchas activos[/B]</label>
                </control>
            </control>

            <!-- ======================================================== -->
            <!-- TARJETA 2: ANDROID (ID 200)                              -->
            <!-- ======================================================== -->
            <control type="group">
                <control type="button" id="200">
                    <left>980</left><top>410</top>
                    <width>430</width><height>280</height>
                    <label></label>
                    <texturefocus border="16" colordiffuse="35FF9900">white.png</texturefocus>
                    <texturenofocus border="16" colordiffuse="15FFFFFF">white.png</texturenofocus>
                    <pulseonselect>true</pulseonselect>
                    <onleft>100</onleft>
                    <onright>100</onright>
                    <onup>200</onup>
                    <ondown>200</ondown>
                </control>
                <!-- Borde al enfocar Android -->
                <control type="image">
                    <left>980</left><top>410</top>
                    <width>430</width><height>280</height>
                    <texture border="16">dialog_border.png</texture>
                    <colordiffuse>90FF9900</colordiffuse>
                    <visible>Control.HasFocus(200)</visible>
                </control>
                <!-- Título Android -->
                <control type="label">
                    <left>980</left><top>495</top>
                    <width>430</width><height>45</height>
                    <font>font16</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <align>center</align>
                    <scroll>false</scroll>
                    <label>[B]Android[/B]</label>
                </control>
                <!-- Estado Android -->
                <control type="label">
                    <left>980</left><top>560</top>
                    <width>430</width><height>30</height>
                    <font>font13</font>
                    <textcolor>FFFF9900</textcolor>
                    <align>center</align>
                    <scroll>false</scroll>
                    <label>[B]● Ocultar Captchas[/B]</label>
                </control>
            </control>
        </control>
    </controls>
</window>
