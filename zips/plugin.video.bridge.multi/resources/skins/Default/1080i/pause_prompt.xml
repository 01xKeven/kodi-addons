        <!-- TARJETA DEL POPUP DE PAUSA CON ESQUINAS REDONDEADAS Y ANIMACIÓN SUAVE -->
        <control type="group" id="50">
            <animation type="WindowOpen" reversible="false">
                <effect type="fade" start="0" end="100" time="220" tween="sine" />
                <effect type="slide" start="70,0" end="0,0" time="220" tween="quadratic" easing="out" />
                <effect type="zoom" start="86" end="100" center="1605,956" time="220" tween="quadratic" easing="out" condition="!String.IsEqual(Window(10000).Property(bridge.pp_pos),0)" />
                <effect type="zoom" start="86" end="100" center="1605,116" time="220" tween="quadratic" easing="out" condition="String.IsEqual(Window(10000).Property(bridge.pp_pos),0)" />
            </animation>
            <animation type="WindowClose" reversible="false">
                <effect type="fade" start="100" end="0" time="150" tween="sine" />
                <effect type="zoom" start="100" end="90" center="1605,956" time="150" tween="quadratic" easing="in" condition="!String.IsEqual(Window(10000).Property(bridge.pp_pos),0)" />
                <effect type="zoom" start="100" end="90" center="1605,116" time="150" tween="quadratic" easing="in" condition="String.IsEqual(Window(10000).Property(bridge.pp_pos),0)" />
            </animation>

