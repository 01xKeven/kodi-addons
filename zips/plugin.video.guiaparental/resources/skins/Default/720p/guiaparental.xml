                <animation effect="fade" start="100" end="0" time="250" delay="100">WindowClose</animation>
                <animation effect="slide" start="0,0" end="-30,0" time="250" tween="quadratic" easing="in" delay="100">WindowClose</animation>
            </control>

            <!-- 4. Alcohol/Drogas -->
            <control type="label" id="104">
